# ============== CONTOH .env PRODUKSI (cPanel) ==============
APP_NAME="Cafe POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.domainanda.com
# Boleh lebih dari satu, pisahkan koma
FRONTEND_URL=https://app.domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_cafe
DB_USERNAME=cpaneluser_cafe
DB_PASSWORD=password_database_anda
DB_TIMEZONE=+07:00

# Tanpa Redis: pakai database/file
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Password awal akun owner saat seeding (WAJIB diganti setelah login)
OWNER_DEFAULT_PASSWORD=GantiPassword123!
# Isi true hanya jika ingin data demo di produksi
SEED_DEMO=false

# Payment gateway opsional: midtrans | xendit | (kosong = nonaktif)
PAYMENT_GATEWAY=
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Upload gambar (opsional). Default: <backend>/public/uploads
# Isi jika folder public Laravel bukan document root, mis.:
# PUBLIC_UPLOAD_PATH=/home/cpaneluser/api.domainanda.com/uploads
# PUBLIC_UPLOAD_URL=https://api.domainanda.com/uploads
PUBLIC_UPLOAD_PATH=
PUBLIC_UPLOAD_URL=

# Installer tanpa SSH: isi string acak >= 32 karakter, KOSONGKAN setelah selesai
SETUP_TOKEN=